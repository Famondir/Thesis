opacity = 0.9,              # opacity of nodes. 0=transparent. 1=no transparency
zoom = T                    # Can you zoom on the figure?
)
sigma_from_igraph(
p
) %>%
sg_nodes(nodes, id, label, size) %>%
sg_edges(edges, id, source, target, type, size) %>%
sg_layout() %>%
sg_cluster(directed = TRUE) %>%
sg_drag_nodes() %>%
sg_neighbours()
sigma_from_igraph(
p
)
